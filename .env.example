# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=false

# ─── Admin seed credentials (used on first run only) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=loyalty_db
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=loyaltypass
DATABASE_URL=postgresql://loyalty:loyaltypass@db:5432/loyalty_db

# ─── Loyalty configuration ────────────────────────────────────────────────────
LOYALTY_CONFIG_PATH=config/pizzeria.json

# Public base URL of this app (used in wallet pass callbacks)
APP_BASE_URL=http://localhost:5000

# ─── Google Wallet (optional) ────────────────────────────────────────────────
# 1. Create a Google Pay & Wallet Console account
# 2. Enable the Google Wallet API and create an Issuer account
# 3. Create a service account and download the JSON key
# 4. Share the service account email with your Issuer ID
#
# GOOGLE_WALLET_ISSUER_ID=3388000000012345678
# GOOGLE_WALLET_CLASS_SUFFIX=loyalty_card
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/wallet_data/google-service-account.json

# ─── Apple Wallet (optional) ─────────────────────────────────────────────────
# 1. Enroll in Apple Developer Program
# 2. Create a Pass Type ID in the Certificates section
# 3. Generate and download your pass certificate (.p12)
# 4. Convert to PEM: openssl pkcs12 -in cert.p12 -nokeys -out cert.pem
#    and: openssl pkcs12 -in cert.p12 -nocerts -nodes -out key.pem
# 5. Download WWDR certificate from https://www.apple.com/certificateauthority/
#
# APPLE_PASS_TYPE_ID=pass.com.yourcompany.loyalty
# APPLE_TEAM_ID=ABCDE12345
# APPLE_CERT_PEM=/app/wallet_data/apple-cert.pem
# APPLE_KEY_PEM=/app/wallet_data/apple-key.pem
# APPLE_WWDR_PEM=/app/wallet_data/apple-wwdr.pem

# ─── Samsung Wallet (optional) ───────────────────────────────────────────────
# 1. Apply for Samsung Wallet Partner Program at https://developer.samsung.com/wallet
# 2. Create a card type in the Samsung Wallet Partner Portal
# 3. Generate API credentials
#
# SAMSUNG_SERVICE_ID=your-service-id
# SAMSUNG_API_KEY=your-api-key
# SAMSUNG_CARD_TYPE_ID=your-card-type-id
